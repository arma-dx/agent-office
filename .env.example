# Server-side variables only. apps/web reads no environment variables; no VITE_ prefixed variable is defined.
NODE_ENV=development
LOG_LEVEL=info
# Locally reachable from this machine only. In the Docker step the container environment sets HOST=0.0.0.0.
HOST=127.0.0.1
PORT=3000

# API database connection: the restricted login role office_api (member of office_app and
# office_api_private, no BYPASSRLS; rule 9), never the postgres role. The API checks the role at
# startup and refuses to start with any other. Its password is set with \password during setup
# (docs/supabase-kurulum.md). Local Supabase example:
DATABASE_URL=postgresql://office_api:<password>@127.0.0.1:54322/postgres

# Where the panel is served. An https origin without a path (https://office.armadx.com), or exactly
# http://localhost:5173 locally, which also switches the cookies to their local form (no __Host-
# prefix, no Secure). The API answers under this origin at /api. Its host is also the passkeys'
# relying party ID and the origin the only one a passkey ceremony is accepted from: passkeys
# registered under one host do not work under another, so changing the host means everyone
# registers new passkeys.
PANEL_ORIGIN=http://localhost:5173

# Signs the short-lived Google sign-in cookie. At least 32 characters; generate one per environment
# with: openssl rand -base64 48
COOKIE_SECRET=

# Google sign-in client (docs/google-kurulum.md). The three values are set together or left empty;
# empty means Google sign-in is not configured and the login page says it is unavailable. The
# redirect URI is PANEL_ORIGIN followed by /api/auth/google/callback, for example
# http://localhost:5173/api/auth/google/callback locally.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# External accounts (outside COMPANY_EMAIL_DOMAINS) must show two-step verification in the ID
# token's amr claim (3 October decision 8). false only for a local trial; refused in production.
AUTH_REQUIRE_AMR=true

# Company Workspace domains, comma separated. Their addresses are accepted only from that Workspace
# (the ID token's hd), where the administrator enforces two-step verification.
COMPANY_EMAIL_DOMAINS=armadx.com,pillika.com

# Reverse proxies whose X-Forwarded-For is trusted (client address for rate limits): addresses or
# CIDR ranges, comma separated. Empty locally; required in production. List every proxy between the
# browser and the API: the Caddy container's network AND Cloudflare's published ranges
# (https://www.cloudflare.com/ips/). Caddy must trust the same Cloudflare ranges (trusted_proxies),
# or it replaces X-Forwarded-For with the Cloudflare address. With only Caddy listed, every person
# behind one Cloudflare address shares one rate limit counter.
TRUST_PROXY=

# Worker database connection: the restricted login role office_worker (member of office_app only,
# no BYPASSRLS; rule 9). Not the API's role: an agent run must not reach the identity tables. The
# worker checks the role at startup and refuses any other. `pnpm db:local-role` sets its local
# password too. Local Supabase example:
# WORKER_DATABASE_URL=postgresql://office_worker:<password>@127.0.0.1:54322/postgres
WORKER_DATABASE_URL=

# Claude API key (console.anthropic.com), read by the worker only and never by the API or the
# panel. Empty: the worker still starts, every agent run ends at once with "model_unavailable" and
# the request falls to the founder. Required in production. Use a separate key per environment,
# from a workspace with a spending limit. Never commit a value.
ANTHROPIC_API_KEY=

# How many agent runs the worker executes at the same time (1 to 8).
WORKER_CONCURRENCY=2

# Tests only: the privileged URL of the local PostgreSQL. The tests create their own database on
# this server, apply the migrations and connect with the restricted application role. If empty,
# the database tests are skipped.
# Vitest does not read .env; pass it on the command line: TEST_DATABASE_URL=... pnpm test
# Local Supabase default:
# TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
