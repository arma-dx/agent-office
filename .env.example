# Yalnızca sunucu tarafı değişkenler. apps/web hiçbir ortam değişkeni okumaz; VITE_ ile başlayan değişken tanımlanmaz.
NODE_ENV=development
LOG_LEVEL=info
# Yerelde yalnızca bu makineden erişilir. Docker adımında konteyner ortamında HOST=0.0.0.0 verilir.
HOST=127.0.0.1
PORT=3000

# Yalnızca testler: yerel PostgreSQL'in yetkili adresi. Testler bu sunucuda kendi veritabanını açar,
# göçleri uygular ve kısıtlı uygulama rolüyle bağlanır. Boşsa veritabanı testleri atlanır.
# Vitest .env okumaz; komut satırında verin: TEST_DATABASE_URL=... pnpm test
# Supabase yerel varsayılanı:
# TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
