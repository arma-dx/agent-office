# Server-side variables only. apps/web reads no environment variables; no VITE_ prefixed variable is defined.
NODE_ENV=development
LOG_LEVEL=info
# Locally reachable from this machine only. In the Docker step the container environment sets HOST=0.0.0.0.
HOST=127.0.0.1
PORT=3000

# Tests only: the privileged URL of the local PostgreSQL. The tests create their own database on
# this server, apply the migrations and connect with the restricted application role. If empty,
# the database tests are skipped.
# Vitest does not read .env; pass it on the command line: TEST_DATABASE_URL=... pnpm test
# Local Supabase default:
# TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
