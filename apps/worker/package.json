{
  "name": "@agent-office/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node src/main.ts",
    "typecheck": "tsc -p tsconfig.json",
    "smoke": "node --input-type=module -e \"import { globSync } from 'node:fs'; import { pathToFileURL } from 'node:url'; for (const file of globSync('src/**/*.ts')) { if (!file.endsWith('main.ts')) await import(pathToFileURL(file).href); }\"",
    "smoke:claude": "node --env-file-if-exists=../../.env scripts/smoke-claude.ts",
    "probe:questions": "node --env-file-if-exists=../../.env scripts/probe-questions.ts",
    "probe:files": "node --env-file-if-exists=../../.env scripts/probe-files.ts"
  },
  "dependencies": {
    "@agent-office/db": "workspace:*",
    "@agent-office/shared": "workspace:*",
    "@anthropic-ai/sdk": "catalog:",
    "pg": "catalog:",
    "pg-boss": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "catalog:"
  }
}
