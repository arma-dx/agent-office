{
  "name": "@agent-office/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node src/main.ts",
    "typecheck": "tsc -p tsconfig.json",
    "smoke": "node --input-type=module -e \"await import('./src/env.ts'); await import('./src/server.ts')\""
  },
  "dependencies": {
    "@agent-office/db": "workspace:*",
    "@agent-office/shared": "workspace:*",
    "@fastify/cookie": "catalog:",
    "@fastify/rate-limit": "catalog:",
    "fastify": "catalog:",
    "openid-client": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:"
  }
}
