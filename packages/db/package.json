{
  "name": "@agent-office/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./cards": "./src/cards.ts",
    "./definitions": "./src/definitions.ts",
    "./test/database": "./test/database.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "smoke": "node --input-type=module -e \"await import('./src/index.ts'); await import('./src/definitions.ts')\" && node scripts/sync-definitions.ts --check"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "catalog:"
  },
  "dependencies": {
    "@agent-office/shared": "workspace:*",
    "pg": "catalog:",
    "pg-boss": "catalog:",
    "yaml": "catalog:",
    "zod": "catalog:"
  }
}
